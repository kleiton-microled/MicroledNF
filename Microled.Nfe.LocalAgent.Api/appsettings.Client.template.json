{
  "LocalAgent": {
    "Port": {{LOCAL_AGENT_PORT}},
    "AllowedOrigins": {{ALLOWED_ORIGINS_JSON}}
  },
  "Certificate": {
    "Mode": "Store",
    "StoreLocation": "CurrentUser",
    "StoreName": "My",
    "Thumbprint": "{{CERT_THUMBPRINT}}"
  },
  "NfeIntegration": {
    "SendToWebService": true,
    "MainApiBaseUrl": "{{MAIN_API_URL}}"
  },
  "NfeValidation": {
    "ValidateXmlAndRps": true,
    "OutputDirectory": "",
    "FileNamePrefix": "NFE_SP",
    "IncludeTimestamp": true
  },
  "NfeServiceOptions": {
    "UseProduction": {{USE_PRODUCTION}},
    "Environment": "{{ENVIRONMENT}}",
    "DefaultIssuerCnpj": "{{CNPJ}}",
    "DefaultIssuerIm": "{{IM}}",
    "DefaultCnpjRemetente": "{{CNPJ}}",
    "LogPrefeituraResponse": true,
    "LogRawXml": false,
    "LogSensitiveData": false
  }
}
