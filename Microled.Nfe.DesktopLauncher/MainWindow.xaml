<Window x:Class="Microled.Nfe.DesktopLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microled NFe — Ambiente local"
        Height="640" Width="820"
        MinHeight="560" MinWidth="720"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"
               Text="Ambiente local da NFS-e"/>
    <TextBlock DockPanel.Dock="Top" FontSize="13" Foreground="#555" Margin="0,0,0,16"
               Text="Use este painel para ligar o sistema no computador. Não é necessário Docker, Node ou Visual Studio."/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="StartButton" Content="Iniciar ambiente" Width="150" Height="36" Margin="0,0,8,0" Click="OnStartClick"/>
      <Button x:Name="StopButton" Content="Parar" Width="90" Height="36" Margin="0,0,8,0" Click="OnStopClick"/>
      <Button x:Name="OpenButton" Content="Abrir sistema" Width="120" Height="36" Margin="0,0,8,0" Click="OnOpenClick"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="16" CornerRadius="6" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.ColumnSpan="3" Text="Arquivo do Access (NF.mdb)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox x:Name="AccessPathBox" Grid.Row="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
          <Button Grid.Row="1" Grid.Column="1" Content="Procurar..." Width="100" Height="28" Margin="0,0,8,0" Click="OnBrowseAccessClick"/>
          <Button Grid.Row="1" Grid.Column="2" Content="Salvar caminho" Width="120" Height="28" Click="OnSaveAccessClick"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{StaticResource CardBrush}" Padding="16" CornerRadius="6" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <UniformGrid Columns="4">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <Ellipse x:Name="PostgresLight" Width="12" Height="12" Fill="#C0C0C0" Margin="0,0,6,0"/>
              <TextBlock Text="Banco"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <Ellipse x:Name="ApiLight" Width="12" Height="12" Fill="#C0C0C0" Margin="0,0,6,0"/>
              <TextBlock Text="API"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <Ellipse x:Name="AgentLight" Width="12" Height="12" Fill="#C0C0C0" Margin="0,0,6,0"/>
              <TextBlock Text="Agente"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="FrontLight" Width="12" Height="12" Fill="#C0C0C0" Margin="0,0,6,0"/>
              <TextBlock Text="Sistema"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="Certificado digital" FontWeight="SemiBold" Margin="0,14,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CertificateBox" Height="28" DisplayMemberPath="." IsEditable="False"/>
            <Button Grid.Column="1" Content="Atualizar lista" Width="120" Height="28" Margin="8,0,8,0" Click="OnRefreshCertificatesClick"/>
            <Button Grid.Column="2" Content="Usar este certificado" Width="160" Height="28" Click="OnSelectCertificateClick"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="12" CornerRadius="6">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="Console" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Copiar" Width="90" Height="26" Click="OnCopyLogClick"/>
          </DockPanel>
          <TextBox x:Name="LogBox"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   FontSize="12"
                   BorderThickness="0"
                   Padding="8"
                   Background="#1E1E1E"
                   Foreground="#D4D4D4"
                   CaretBrush="#D4D4D4"
                   SelectionBrush="#264F78"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
