<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Microled.Nfe.DesktopLauncher</AssemblyName>
    <RootNamespace>Microled.Nfe.DesktopLauncher</RootNamespace>
    <Product>Microled NFe Ambiente Local</Product>
    <Description>Painel gráfico para subir API, front, PostgreSQL e LocalAgent no PC do cliente.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
  </ItemGroup>
</Project>
